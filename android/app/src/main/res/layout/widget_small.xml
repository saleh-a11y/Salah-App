<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/w_root" android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:gravity="center_vertical" android:padding="12dp" android:background="@drawable/widget_bg">
    <TextView android:id="@+id/w_name" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFF1D792" android:textSize="15sp" android:textStyle="bold" android:maxLines="1" android:text="Salah Tracker" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="horizontal" android:gravity="bottom">
        <TextView android:id="@+id/w_time" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="#FFFFFFFF" android:textSize="26sp" android:fontFamily="sans-serif-light" android:text="--:--" />
        <TextView android:id="@+id/w_label" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:layout_marginStart="6dp" android:layout_marginBottom="4dp" android:textColor="#FFCFE0D6" android:textSize="12sp" android:maxLines="1" />
    </LinearLayout>
    <Chronometer android:id="@+id/w_cd" android:layout_width="wrap_content" android:layout_height="wrap_content"
        android:textColor="#FFE6C983" android:textSize="13sp" />
</LinearLayout>
